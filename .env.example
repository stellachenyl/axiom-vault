# Copy to .env.local and point at your published problem-packs folder.
# Leave unset to use the local fallback (public/problem-packs).
VITE_PROBLEM_BASE_URL=https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPO/main/problem-packs

# Set when deploying under a GitHub Pages subpath (e.g. /<repo-name>).
# The Pages workflow sets this automatically; only needed for manual deploys.
VITE_BASE_PATH=/YOUR_REPO_NAME
